# Bu dosyayı kopyalayıp adını .env yapın:
#   cp .env.example .env
# .env dosyasını Git'e göndermeyin (.gitignore'da).

PORT=3000

# Dinleme adresi:
# - Yerel tarayıcıda http://localhost:3000 için HOST satırını boş bırakın veya yorumda tutun
#   (Node varsayılanı hem IPv4 hem IPv6 dinler).
# - PaaS / Docker / uzaktan erişim: HOST=0.0.0.0
# DİKKAT: HOST=0.0.0.0 yalnızca IPv4 dinler; macOS/Windows'ta localhost → ::1
# bağlanırsa ERR_CONNECTION_REFUSED görürsünüz. O durumda http://127.0.0.1:3000 kullanın
# veya HOST satırını kaldırın.
# HOST=0.0.0.0

# JWT (canlıda mutlaka güçlü rastgele değer)
# JWT_SECRET=uzun-rastgele-bir-metin

# PostgreSQL (yerel)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=buraya_sifreni_yaz

# Canlı / Neon / Render: connection string (DB_* yerine geçer)
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# E-posta (Sistem Parametreleri SMTP_* ile de ayarlanabilir; burada yalnızca örnek)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# e-Belge (GİB e-Fatura / e-Arşiv / e-İrsaliye) — kimlik bilgileri YALNIZCA ortam değişkeninde tutulur.
# Canlı mod: Sistem Parametreleri GIB_CANLI=Evet + EBELGE_SAGLAYICI=REST + aşağıdaki canlı değerler eksiksiz.
# Eksikse gönderim Hata (EBELGE_CANLI_KIMLIK_EKSIK) olur; mock'a düşülmez. Eksik anahtarlar: GET /e-belge/durum/ozet
# EBELGE_REST_BASE_URL=https://api.entegrator.example/efatura
# EBELGE_REST_USERNAME=
# EBELGE_REST_PASSWORD=
# EBELGE_REST_API_KEY=
# Entegratör test ortamı (GIB_CANLI=Hayir iken kullanılır; boşsa yerel mock):
# EBELGE_REST_TEST_BASE_URL=https://test.entegrator.example/efatura
# EBELGE_REST_TEST_USERNAME=
# EBELGE_REST_TEST_PASSWORD=
# EBELGE_REST_TEST_API_KEY=
# EBELGE_REST_TIMEOUT_MS=30000
# GİB portal (manuel yükleme) canlı kullanıcısı:
# EBELGE_PORTAL_KULLANICI=
