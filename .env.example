# Bu dosyayı kopyalayıp adını .env yap:
#   cp .env.example .env
# .env dosyasını Git'e gönderme (gitignore'da).

PORT=3000
# PaaS (Render/Fly): HOST=0.0.0.0
# HOST=0.0.0.0

# JWT (canlıda mutlaka değiştirin)
# JWT_SECRET=uzun-rastgele-bir-metin

# PostgreSQL (yerel)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=buraya_sifreni_yaz

# Canlı / Neon / Render: connection string (DB_* yerine geçer)
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# İkinci hedef: bilgisayarındaki PostgreSQL (tünel URL — Cloud Agent laptop localhost’una bağlanamaz)
# DB_MIRROR_URL=postgresql://postgres:SIFRE@TUNEL_HOST:PORT/postgres
# LOCAL_DATABASE_URL=...   # DB_MIRROR_URL ile aynı anlamda (alias)

# E-posta (Sistem Parametreleri SMTP_* ile de ayarlanabilir; burada yalnızca örnek)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
