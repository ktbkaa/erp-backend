# Bu dosyayı kopyalayıp adını .env yap:
#   cp .env.example .env
# .env dosyasını Git'e gönderme (gitignore'da).

PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=buraya_sifreni_yaz

# Opsiyonel: doğrudan connection string (DB_* yerine)
# DATABASE_URL=postgresql://user:pass@localhost:5432/postgres

# E-posta (Sistem Parametreleri SMTP_* ile de ayarlanabilir; burada yalnızca örnek)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
