# Bu dosyayı kopyalayıp adını .env yapın:
#   cp .env.example .env
# .env dosyasını Git'e göndermeyin (.gitignore'da). Gerçek şifre/token bu şablona yazılmaz.
# Ortam ayrımı ve canlı değerleri: docs/go-live/ORTAMLAR_VE_IZLEME.md

# --- Ortam -------------------------------------------------------------------
# development (varsayılan) | test | production
# production: JSON log, zorunlu JWT_SECRET, ERP_AUTH_SOFT=1 yasak, auth zorunlu.
# NODE_ENV=development

PORT=3000

# Dinleme adresi:
# - Yerel tarayıcıda http://localhost:3000 için HOST satırını boş bırakın veya yorumda tutun
#   (Node varsayılanı hem IPv4 hem IPv6 dinler).
# - PaaS / Docker / uzaktan erişim: HOST=0.0.0.0
# DİKKAT: HOST=0.0.0.0 yalnızca IPv4 dinler; macOS/Windows'ta localhost → ::1
# bağlanırsa ERR_CONNECTION_REFUSED görürsünüz. O durumda http://127.0.0.1:3000 kullanın
# veya HOST satırını kaldırın.
# HOST=0.0.0.0

# Ters vekil (Render/Caddy/Nginx) arkasında gerçek istemci IP'si için hop sayısı
# TRUST_PROXY=1

# JWT (canlıda zorunlu; en az 32 karakter rastgele: openssl rand -hex 32)
# JWT_SECRET=uzun-rastgele-bir-metin

# Kimlik: canlıda ERP_AUTH_REQUIRED=true; ERP_AUTH_SOFT=1 yalnız yerel/test (production'da açılış reddedilir)
# ERP_AUTH_REQUIRED=true
# ERP_AUTH_SOFT=1

# Açılışta demo firma / örnek veri onarımı. Canlıda mutlaka 0.
# AUTO_HEAL=0
# TCMB kur zamanlayıcısı (çoklu instance'ta yalnız birinde açık bırakın)
# TCMB_SCHEDULER=off

# --- PostgreSQL --------------------------------------------------------------
# Yerel
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=buraya_sifreni_yaz

# Canlı / Neon / Render: connection string (DB_* yerine geçer)
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
# DB_POOL_MAX=10
# DB_SSL_REJECT_UNAUTHORIZED=1

# --- Loglama / sağlık ---------------------------------------------------------
# LOG_FORMAT=json            # json | pretty (varsayılan: production'da json)
# LOG_LEVEL=info             # debug | info | warn | error | silent
# LOG_HTTP=1                 # HTTP erişim logu (X-Request-Id ile)
# LOG_HTTP_SKIP_STATIC=1     # statik dosya ve /health,/ready loglanmaz
# LOG_CONSOLE_BRIDGE=1       # json'da mevcut console.* çıktılarını da JSON yapar
# READY_DB_TIMEOUT_MS=2000
# READY_REQUIRE_MIGRATIONS=1 # bekleyen migration varsa /ready 503
# SHUTDOWN_TIMEOUT_MS=15000
# SHUTDOWN_DRAIN_MS=5000     # SIGTERM sonrası /ready 503 iken LB'nin trafiği çekme süresi

# --- Yedekleme (scripts/db-backup.js, db-restore.js, db-restore-drill.js) ------
# Docs: docs/go-live/YEDEKLEME_GERI_DONUS_RUNBOOK.md
# BACKUP_DIR=./backups
# BACKUP_DATABASE_URL=       # yedek için ayrı (salt-okunur) kullanıcı; yoksa DATABASE_URL / DB_*
# BACKUP_RETENTION_DAYS=14   # yerel dosya saklama
# BACKUP_ROW_COUNTS=exact    # exact | estimate | off (manifest satır sayıları)
# BACKUP_ENCRYPTION_PASSPHRASE=   # >=16 karakter; AES-256-GCM. KAYBI = YEDEK KAYBI, ayrı kasada saklayın
# BACKUP_NOTIFY_WEBHOOK_URL=      # Slack/Teams webhook (hata bildirimi)
# BACKUP_NOTIFY_ON_SUCCESS=0
# PG_DUMP_PATH= / PG_RESTORE_PATH= / PSQL_PATH= / PG_BIN_DIR=   # pg araçları PATH'te değilse

# Offsite hedefi: none | s3 | rsync | command
# BACKUP_OFFSITE=none
#
# s3 (AWS S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO…) — kimlik bilgisi yalnız env'den:
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=erp-backups/
# BACKUP_S3_REGION=eu-central-1   # R2: auto
# BACKUP_S3_ENDPOINT=             # AWS dışı: https://<hesap>.r2.cloudflarestorage.com
# BACKUP_S3_FORCE_PATH_STYLE=     # ENDPOINT verilmişse varsayılan 1
# BACKUP_S3_ACCESS_KEY_ID=        # (veya AWS_ACCESS_KEY_ID)
# BACKUP_S3_SECRET_ACCESS_KEY=    # (veya AWS_SECRET_ACCESS_KEY)
# BACKUP_S3_SSE=                  # AES256 | aws:kms (AWS)
# BACKUP_S3_STORAGE_CLASS=        # ör. STANDARD_IA
# BACKUP_S3_RETENTION_DAYS=0      # >0: eski nesneleri sil (en yeni BACKUP_S3_MIN_KEEP korunur); tercihen bucket lifecycle
# BACKUP_S3_MIN_KEEP=3
#
# rsync (SSH ile başka sunucu / NAS):
# BACKUP_RSYNC_TARGET=backup@yedek.example.com:/srv/ktb-erp/
# BACKUP_RSYNC_SSH_KEY=/run/secrets/backup_key
# BACKUP_RSYNC_SSH_PORT=22
# BACKUP_RSYNC_OPTS=
#
# command (rclone, aws CLI, az… — dosya yolu $BACKUP_FILE):
# BACKUP_OFFSITE_COMMAND=rclone copy "$BACKUP_FILE" remote:ktb-erp/

# Deploy ön adımı (scripts/predeploy.js)
# PREDEPLOY_BACKUP=pending   # pending | always | never
# PREDEPLOY_BACKUP_REQUIRED=1

# Geri yükleme / tatbikat
# RESTORE_TARGET_URL=             # db-restore.js hedefi (uygulama DB'si varsayılan DEĞİL)
# RESTORE_DRILL_ADMIN_URL=        # tatbikat geçici DB'sinin oluşturulacağı sunucu (…/postgres)
# RESTORE_DRILL_MAX_BACKUP_AGE_HOURS=30

# --- İzole test (npm run test:isolated) --------------------------------------
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/erp_test

# --- Docker compose (docker-compose.yml değişken ikamesi) ----------------------
# POSTGRES_PASSWORD=          # zorunlu
# POSTGRES_USER=ktb_erp
# POSTGRES_DB=ktb_erp
# POSTGRES_HOST_PORT=5433
# APP_PORT=3000
# APP_BIND=127.0.0.1          # Caddy (proxy profili) kullanılıyorsa 127.0.0.1 kalsın
# ERP_DOMAIN=erp.example.com  # proxy profili: otomatik HTTPS
# ACME_EMAIL=it@example.com
# PG_CLIENT_VERSION=16

# --- E-posta (Sistem Parametreleri SMTP_* ile de ayarlanabilir; burada yalnızca örnek)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
