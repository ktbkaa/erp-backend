# Bu dosyayı kopyalayıp adını .env yapın:
#   cp .env.example .env
# .env dosyasını Git'e göndermeyin (.gitignore'da).

PORT=3000

# Dinleme adresi:
# - Yerel tarayıcıda http://localhost:3000 için HOST satırını boş bırakın veya yorumda tutun
#   (Node varsayılanı hem IPv4 hem IPv6 dinler).
# - PaaS / Docker / uzaktan erişim: HOST=0.0.0.0
# DİKKAT: HOST=0.0.0.0 yalnızca IPv4 dinler; macOS/Windows'ta localhost → ::1
# bağlanırsa ERR_CONNECTION_REFUSED görürsünüz. O durumda http://127.0.0.1:3000 kullanın
# veya HOST satırını kaldırın.
# HOST=0.0.0.0

# Ortam: canlıda NODE_ENV=production (boşsa ve Render/Heroku/Railway/Fly algılanırsa da canlı sayılır)
# NODE_ENV=development

# JWT (canlıda zorunlu; eksik veya bu örnek değerse sunucu açılmaz). Üret: openssl rand -base64 48
# JWT_SECRET=uzun-rastgele-bir-metin

# Rol / ekran yetkisi (src/auth/permissionMap.js). Varsayılan: enforce.
# audit → ekran/modül reddi yalnız loglanır ([yetki] AUDIT-DENY), istek geçer (kademeli geçiş).
# Yönetici (ADMIN) gerektiren uçlar her modda zorunludur.
# ERP_RBAC_MODE=audit

# Demo firmalar (GIDA, DOKUM, …) + OG-* örnek veri + demo firma yetkileri.
# Yalnız yerel/demo ortamda 1 yapın; canlıda TANIMLAMAYIN.
# Bayrak yoksa açılış heal’i ve 082/083 demo seed migration’ları çalışmaz.
# SEED_DEMO_DATA=1

# Firma yöneticileri (ADMIN grubu / yonetici rolü / owner) varsayılan olarak tüm firmalara erişir.
# 0 → yöneticiler de yalnız user_company_permissions’taki firmalara erişir.
# FIRMA_ADMIN_TUM_FIRMALAR=0

# --- Güvenlik (ayrıntı: README «Canlı (production) güvenlik ayarları») ---
# CORS: virgüllü origin listesi. Boşken canlıda yalnız aynı origin, yerelde her origin.
# ALLOWED_ORIGINS=https://erp.ornek.com
# Süper admin (SQL konsolu / sistem güncelleme). Boşsa group_code=ADMIN.
# SUPER_ADMIN_USERS=ADMIN
# SQL konsolu: canlıda varsayılan kapalı; açılırsa salt-okunur + harici DB bağlantısı kapalı.
# ENABLE_SQL_CONSOLE=0
# SQL_CONSOLE_READONLY=0
# SQL_CONSOLE_ALLOW_EXTERNAL_DB=1
# Sistem güncelleme paket uygulama (/sistem-guncelleme/uygula): canlıda varsayılan kapalı.
# ENABLE_SYSTEM_UPDATE_APPLY=0
# Ters vekil hop sayısı (rate limit / audit IP). Canlıda varsayılan 1.
# TRUST_PROXY=1
# Giriş denemesi sınırı (IP başına başarısız deneme / pencere ms)
# AUTH_LOGIN_RATE_MAX=10
# AUTH_LOGIN_RATE_WINDOW_MS=900000
# AUTH_REFRESH_RATE_MAX=60
# JSON gövde limitleri
# JSON_BODY_LIMIT=1mb
# LARGE_JSON_BODY_LIMIT=5mb
# CSP: enforce | report-only | off
# CSP_MODE=enforce
# Sırlar yalnız env’den (system_parameters fallback kapalı)
# SECRETS_FROM_ENV_ONLY=1
# Demo / QA script parolaları (canlıda zorunlu, yerelde varsayılan demo değeri)
# DEMO_PASS=
# QA_USER=
# QA_PASS=
# QA_ADMIN_PASS=

# PostgreSQL (yerel)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=buraya_sifreni_yaz

# Canlı / Neon / Render: connection string (DB_* yerine geçer)
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
# TLS sertifika doğrulaması: canlıda varsayılan 1. Kendinden imzalı CA için DB_SSL_CA (PEM veya dosya yolu).
# DB_SSL_REJECT_UNAUTHORIZED=1
# DB_SSL_CA=/etc/ssl/certs/db-ca.pem

# E-posta: env değerleri system_parameters’ın önüne geçer (SMTP_PASS’i yalnız env’de tutun)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# LDAP (env değerleri system_parameters’ın önüne geçer)
# LDAP_ENABLED=Hayir
# LDAP_URL=ldaps://dc.ornek.com
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
