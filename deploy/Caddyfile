# Caddy — otomatik HTTPS (Let's Encrypt) ters vekil. docker compose --profile proxy up -d
# ERP_DOMAIN: DNS A kaydı bu sunucuyu gösteren alan adı (ör. erp.firma.com.tr)
{
	email {$ACME_EMAIL}
}

{$ERP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		health_uri /ready
		health_interval 10s
		header_up X-Request-Id {http.request.uuid}
	}

	log {
		output stdout
		format json
	}
}
