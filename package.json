{
  "name": "erp-backend",
  "version": "0.3.0",
  "description": "ERP çekirdek — satınalma ve üretim döngüsü",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "migrate": "node db/migrate.js",
    "db:backup": "node scripts/db-backup.js",
    "demo:cycle": "node scripts/demo-cycle.js",
    "demo:cleanup": "node scripts/demo-cleanup.js",
    "demo:4-firma": "node scripts/demo-4-firma.js",
    "test": "npm run test:screens && node --test tests/**/*.test.js",
    "test:screens": "node scripts/check-screen-contracts.js",
    "demo:ornek-dongu": "node scripts/ornek-dongu-cn-tr-de.js",
    "demo:mrp": "node scripts/demo-mrp-ornek.js",
    "demo:elek-dongu": "node scripts/demo-elek-tam-dongu.js",
    "demo:gida-dongu": "node scripts/demo-gida-tam-dongu.js",
    "demo:kilif-dongu": "node scripts/demo-kilif-tam-dongu.js",
    "demo:dokum-prj": "node scripts/demo-dokum-prj.js",
    "demo:teks": "node scripts/demo-teks-tam-dongu.js",
    "demo:teks-dongu": "node scripts/demo-teks-tam-dongu.js",
    "purge:firma": "node scripts/purge-firma-veri.js",
    "ensure:firma-yetki": "node scripts/ensure-firma-yetkileri.js",
    "demo:dokum-dongu": "node scripts/demo-dokum-tam-dongu.js",
    "qa:inventory": "node scripts/qa/extract-screen-inventory.mjs",
    "qa:smoke": "node scripts/qa/api-smoke.mjs",
    "qa:db": "node scripts/qa/db-integrity-audit.mjs",
    "qa:finance-seed": "node scripts/qa/ensure-finance-seed.js",
    "qa:gida-org": "node scripts/qa/ensure-gida-org.js",
    "qa:dokum-org": "node scripts/qa/ensure-dokum-org.js",
    "qa:ornek-gida": "node scripts/qa/rich-ornek-veri.js --firma=GIDA",
    "qa:ornek-dokum": "node scripts/qa/rich-ornek-veri.js --firma=DOKUM",
    "qa:ornek-elek": "node scripts/qa/rich-ornek-veri.js --firma=ELEK",
    "qa:ornek-kilif": "node scripts/qa/rich-ornek-veri.js --firma=KILIF",
    "qa:ornek-all": "node scripts/qa/rich-ornek-veri.js",
    "qa:roles": "node scripts/qa/role-matrix.mjs",
    "qa:capture": "node scripts/qa/capture-ui-evidence.mjs",
    "qa:dashboard": "node scripts/qa/build-qa-dashboard.mjs",
    "qa:pdf": "node scripts/qa/build-qa-pdf.mjs",
    "qa:all": "npm run qa:finance-seed && npm run qa:inventory && npm run qa:smoke && npm run qa:db && npm run qa:roles && npm run qa:dashboard && npm run qa:pdf"
  },
  "keywords": [
    "erp",
    "postgresql",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^9.2.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0"
  }
}
